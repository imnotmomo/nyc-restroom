          || data.get('automaticDoorPresent', 'not-reported') != 'not-reported')
        && data.anonymous is bool
        && (data.anonymous ? data.authorName == null : data.authorName is string
          && data.authorName.size() > 0 && data.authorName.size() <= 120
          && allowedPublicText(data.authorName)
          && data.authorName.matches('^[^\\x00-\\x1F\\x7F]*$')
          && data.authorName.matches('(?s).*[^\\s\\p{Z}\\x85].*')
          && data.authorName == request.auth.token.get('name', null));
    }
    function isValidUnifiedVisitReceipt(data, placeID) {
      return data.keys().hasAll(['placeID', 'submittedAt', 'codeReportID'])
        && data.keys().hasOnly(['placeID', 'submittedAt', 'codeReportID'])
        && data.placeID == placeID && isVisitPlaceID(placeID)
        && data.submittedAt is timestamp && data.submittedAt == request.time
        && (data.codeReportID == null || isPasscodeReportID(data.codeReportID));
    }
    function unifiedFreshCodeMatches(uid, placeID, codeID) {
      let codePath = /databases/$(database)/documents/users/$(uid)/restroomReadyPasscodesV2/$(codeID);
      // Existing V2 rules independently enforce the full owner/reservation,
      // projection and private Saved pair. Here bind a fresh code to this report.
      return !exists(codePath) && getAfter(codePath) != null
        && getAfter(codePath).data.placeID == placeID
        && getAfter(codePath).data.createdAt == request.time
        && getAfter(codePath).data.codeUpdatedAt == request.time;
    }
    function unifiedOptionalCodeMatches(uid, placeID, data, receipt) {
      return receipt.codeReportID == null || (data.codeRequired == 'yes'
        && unifiedFreshCodeMatches(uid, placeID, receipt.codeReportID));
    }
    function isNewUnifiedVisit(uid, placeID, reportID) {
      let publicPath = /databases/$(database)/documents/restroomUnifiedVisits/$(placeID)/reports/$(reportID);
      let privatePath = /databases/$(database)/documents/users/$(uid)/restroomReadyUnifiedVisitReceipts/$(reportID);
      let shared = getAfter(publicPath);
      let receipt = getAfter(privatePath);
      return canContribute(uid) && isPasscodeReportID(reportID)
        && !exists(/databases/$(database)/documents/restroomModerationRemovals/$(placeID)/unifiedVisits/$(reportID))
        && !exists(publicPath) && !exists(privatePath)
        && shared != null && receipt != null
        && isValidUnifiedVisit(shared.data, placeID)
        && isValidUnifiedVisitReceipt(receipt.data, placeID)
        && unifiedOptionalCodeMatches(uid, placeID, shared.data, receipt.data);
    }
    function isOwnerUnifiedVisitDeletion(uid, placeID, reportID) {
      let publicPath = /databases/$(database)/documents/restroomUnifiedVisits/$(placeID)/reports/$(reportID);
      let privatePath = /databases/$(database)/documents/users/$(uid)/restroomReadyUnifiedVisitReceipts/$(reportID);
      let shared = get(publicPath);
      let receipt = get(privatePath);
      return isRatingOwner(uid) && isPasscodeReportID(reportID)
        && shared != null && receipt != null
        && receipt.data.keys().hasAll(['placeID', 'submittedAt', 'codeReportID'])
        && receipt.data.keys().hasOnly(['placeID', 'submittedAt', 'codeReportID'])
        && receipt.data.placeID == placeID && shared.data.placeID == placeID
        && receipt.data.submittedAt is timestamp && receipt.data.submittedAt == shared.data.submittedAt
        && (receipt.data.codeReportID == null || isPasscodeReportID(receipt.data.codeReportID))
        && getAfter(publicPath) == null && getAfter(privatePath) == null;
    }
    match /restroomUnifiedVisits/{placeID}/reports/{reportID} {
      allow get: if isVisitPlaceID(placeID) && isPasscodeReportID(reportID);
      allow list: if isVisitPlaceID(placeID) && request.query.limit != null
        && request.query.limit > 0 && request.query.limit <= 10;
      allow create: if isNewUnifiedVisit(request.auth.uid, placeID, reportID);
      allow update: if false;
      allow delete: if isOwnerUnifiedVisitDeletion(request.auth.uid, placeID, reportID);
    }
    match /users/{uid}/restroomReadyUnifiedVisitReceipts/{reportID} {
      allow get: if isRatingOwner(uid) && isPasscodeReportID(reportID);
      allow list: if isRatingOwner(uid) && request.query.limit != null
        && request.query.limit > 0 && request.query.limit <= 50;
      allow update: if false;
      allow create: if isNewUnifiedVisit(uid, request.resource.data.placeID, reportID);
      allow delete: if isOwnerUnifiedVisitDeletion(uid, resource.data.placeID, reportID);
    }

    // Imported source notes contain only the reviewed public projection; original
    // handles, transcripts and evidence remain in the denied research archive.
    // Browser clients may read a bounded per-place feed, but never write it.
    match /restroomSourceComments/{placeID}/comments/{commentID} {
      allow get: if isVisitPlaceID(placeID) && isPasscodeReportID(commentID);
      allow list: if isVisitPlaceID(placeID) && request.query.limit != null
        && request.query.limit > 0 && request.query.limit <= 10;
      allow create, update, delete: if false;
    }
    match /restroomVisitReports/{placeID}/reports/{reportID} {
      allow get: if isVisitPlaceID(placeID) && isPasscodeReportID(reportID);
      allow list: if isVisitPlaceID(placeID) && request.query.limit != null
        && request.query.limit > 0 && request.query.limit <= 10;
      allow create: if isNewVisitReport(request.auth.uid, placeID, reportID);
      allow update: if false;
      allow delete: if isOwnerVisitDeletion(request.auth.uid, placeID, reportID);
    }
    match /users/{uid}/restroomReadyVisitReceipts/{reportID} {
      allow get: if isRatingOwner(uid) && isPasscodeReportID(reportID);
      allow list: if false;
      allow create: if isNewVisitReport(uid, request.resource.data.placeID, reportID);
      allow update: if false;
      allow delete: if isOwnerVisitDeletion(uid, resource.data.placeID, reportID);
    }
    match /restroomPublicNotes/{placeID}/notes/{noteID} {
      allow get: if isVisitPlaceID(placeID) && isPasscodeReportID(noteID);
      allow list: if isVisitPlaceID(placeID) && request.query.limit != null
        && request.query.limit > 0 && request.query.limit <= 10;
      allow create: if isNewPublicNote(request.auth.uid, placeID, noteID);
      allow update: if false;
      allow delete: if isOwnerPublicNoteDeletion(request.auth.uid, placeID, noteID);
    }
    match /users/{uid}/restroomReadyPublicNoteReceipts/{noteID} {
      allow get: if isRatingOwner(uid) && isPasscodeReportID(noteID);
      allow list: if isRatingOwner(uid) && request.query.limit != null
        && request.query.limit > 0 && request.query.limit <= 50;
      allow create: if isNewPublicNote(uid, request.resource.data.placeID, noteID);
      allow update: if false;
      allow delete: if isOwnerPublicNoteDeletion(uid, resource.data.placeID, noteID);
    }
    match /restroomResearchProfiles/{placeID} {
      allow get: if placeID.size() > 0 && placeID.size() <= 160
        && placeID.matches('^[A-Za-z0-9][A-Za-z0-9:._~-]{0,159}$');
      allow list, create, update, delete: if false;
    }
    match /restroomAccessDetails/{placeID} {
      allow get: if placeID.size() > 0 && placeID.size() <= 160
        && placeID.matches('^[A-Za-z0-9][A-Za-z0-9:._~-]{0,159}$');
      allow list: if request.query.limit != null
        && request.query.limit > 0 && request.query.limit <= 1000;
      allow create, update, delete: if false;
    }
    match /communityRestrooms/{placeID} {
      allow get: if isCommunityPlaceID(placeID);
      allow list: if request.query.limit != null && request.query.limit > 0 && request.query.limit <= 1000;
      allow create, update, delete: if false;
    }
    match /restroomSubmissions/{placeID} {
      allow get: if isRatingOwner(request.auth.uid) && isCommunityPlaceID(placeID)
        && (resource == null || resource.data.ownerUID == request.auth.uid);
      allow list: if false;
      allow create: if isNewPendingCommunityRequest(request.auth.uid, placeID);
      allow update, delete: if false;
    }
    match /users/{uid}/restroomReadySubmissionRequests/{placeID} {
      allow get: if isRatingOwner(uid) && isCommunityPlaceID(placeID);
      allow list: if isRatingOwner(uid) && request.query.limit != null
        && request.query.limit > 0 && request.query.limit <= 50;
      allow create: if isNewPendingCommunityRequest(uid, placeID);
      allow update, delete: if false;
    }
    match /users/{uid}/restroomReadySaved/{placeID} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && isValidSaved(request.resource.data, placeID);
      allow update: if isOwner(uid) && isValidSaved(request.resource.data, placeID)
        && request.resource.data.placeID == resource.data.placeID;
    }
    match /users/{uid}/restroomReadyNotes/{noteID} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && noteID.size() == 20
        && noteID.matches('^[a-zA-Z0-9]{20}$') && isValidNote(request.resource.data);
      allow update: if false;
    }
    match /restroomRatingSummaries/{placeID} {
      allow get: if validPlaceID(placeID);
      allow list: if resource.data.ratingCount > 0;
      allow create: if false;
      allow delete: if false;
      allow update: if isRatingOwner(request.auth.uid)
        && isValidRatingSummary(request.resource.data)
        && isValidRatingTransition(placeID, request.auth.uid);
      match /ratings/{uid} {
        allow get: if isRatingOwner(uid);
        allow list: if false;
        allow create, update: if canContribute(uid)
          && isValidRatingVote(request.resource.data)
          && request.resource.data.updatedAt == request.time
          && isValidRatingTransition(placeID, uid);
        allow delete: if isRatingOwner(uid) && isValidRatingTransition(placeID, uid);
      }
    }
    // Private safety state is readable/writable only through the reviewed Admin backend.
    match /restroomContentReports/{id} { allow read, write: if false; }
    match /restroomContentReportLimits/{uid} { allow read, write: if false; }
    match /restroomContributorSuspensions/{uid} { allow read, write: if false; }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
