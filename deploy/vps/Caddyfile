nyc.imfinethanku.me {
	# BEGIN Restroom Ready moderation
	import /etc/caddy/restroom-ready-moderation.caddy
	# END Restroom Ready moderation
	encode zstd gzip
	header {
		-Server
		Permissions-Policy "geolocation=(self)"
		X-Content-Type-Options nosniff
	}
	@accountDeletion path /api/account/delete
	handle @accountDeletion {
		request_body {
			max_size 2KB
		}
		reverse_proxy 127.0.0.1:3002 {
			transport http {
				response_header_timeout 330s
			}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-RR-Client-IP {remote_host}
		}
	}
}
