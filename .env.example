# Optional. Leave blank until your team creates its own GA4 web data stream.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Used for absolute social metadata when deploying outside Sites.
NEXT_PUBLIC_SITE_URL=
# Local durable signup database; never commit this file or its contents.
WAITLIST_DB_PATH=.data/waitlist.sqlite
# Node runtime only, when hosted behind HTTPS. Set through the service environment.
# Leave unset for local HTTP previews. Plain node does not load .env.local.
# PUBLIC_ORIGIN=https://nyc.imfinethanku.me
# Optional Firebase web config overrides. Defaults use firebase/web-config.json.
# Public SDK identifiers, not Admin keys; Next.js embeds overrides at build time.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Optional domain-restricted Apple Maps web token; enables MapKit JS after rebuild.
NEXT_PUBLIC_MAPKIT_JS_TOKEN=
