[Unit]
Description=Restroom Ready web application
After=network.target

[Service]
Type=simple
User=restroom-ready
Group=restroom-ready
WorkingDirectory=/srv/restroom-ready/current
EnvironmentFile=/etc/restroom-ready/runtime.env
ExecStart=/opt/node/bin/node /srv/restroom-ready/current/scripts/serve.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/restroom-ready
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
