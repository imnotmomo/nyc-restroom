// Restroom Ready account data. Prototype rules; see docs/firebase-setup.md.
// users/{uid}/restroomReadySaved/{placeID}: placeID:string (1..128, immutable
// and equal to document ID), savedAt:timestamp (server write time).
// users/{uid}/restroomReadyNotes/{noteID}: placeID:string (1..128),
// observedAt:timestamp (2000..request.time), submittedAt:timestamp (server time),
// condition:enum, soap/toiletPaper/stairs:enum, entryNote:string (0..1000).
// Notes are immutable after creation; their owner may delete them.
// No users/{uid} profile document is required or created. The UID in the path
// scopes these private subcollections; no identity/role/email field is accepted.
// accountDeletionLocks/{uid}: administrator-only deletion marker. Its existence
// blocks that account's private access and contribution writes, including requests
// with an already-issued token. Server cleanup uses administrative access and
// retains the marker until deletion is complete and old tokens have expired.
// Marker fields are server-owned; every client read/write remains default-denied.
// restroomRatingSummaries/{placeID}: ratingCount:int (0..1,000,000),
// ratingSum:number (multiples of 0.5 in count..5*count, zero for zero count),
// updatedAt:timestamp. Existing integer totals remain valid.
// A trusted initializer/moderator creates source/approved-community summaries.
// Clients cannot create rating parents or publish community listings directly.
// All subsequent changes require a paired private vote; no client deletion.
// restroomRatingSummaries/{placeID}/ratings/{uid}: stars:number (1..5 by 0.5),
// updatedAt:timestamp. Only that signed-in non-anonymous account may GET/write
// its vote. Public reads expose aggregate counts/sums, never raw vote owners.
// communityRestrooms/{community-<20 alphanumeric chars>}: immutable public report.
// name:string (1..120), address:string (1..240), latitude:number (40.49..40.93),
// longitude:number (-74.26..-73.68), locationType:park/library/cafe/restaurant/store/other,
// entryRule:public/customers/unknown, stepFreeAccess:yes/no/unknown,
// notes:string (0..1000), observedOn:null or UTC-midnight timestamp (2000..now),
// submittedAt:timestamp (server time). Bounding rectangle approximates NYC extent;
// a visitor report is neither city-verified access nor a cleanliness guarantee.
// restroomSubmissions/{sameID}: private ownerUID:string (1..128, authenticated UID),
// submittedAt:timestamp (same server time). No public name/email/UID fields accepted.
// The receipt reserves an ID atomically with an owner-private pending request.
// Only backend approval creates the public listing and zero rating parent.
// Public GET and bounded latest-feed LIST expose approved/grandfathered reports;
// only the owner can GET their receipt. No receipt LIST.
// communityRestrooms may additionally contain passcodeRequired:yes/no/unknown.
// Codes never belong in that public listing document.
// users/{uid}/restroomReadySubmissionRequests/{same communityID}: immutable
// client-created pending request, exact schemaVersion:int(1), status:pending,
// revision:int(1), submittedAt:server time, listing:the exact community schema
// at the same timestamp, codeDraft:null or exact {code:ASCII(1..40),visibility}.
// The optional code stays owner-private until backend approval. Terminal
// status/revision/reviewedAt/reason/codeFingerprint are server-owned; raw draft
// codes are scrubbed at review. GET/bounded LIST(50) are owner-only. No client
// update/delete/approval, including from clients claiming moderator privileges.
// restroomModerationRemovals/{placeID}/publicNotes/{noteID} or
// /unifiedVisits/{reportID}: server-only no-body/no-author removal markers.
// Marked IDs cannot be recreated, including after subsequent owner deletion.
// users/{uid}/restroomReadyPasscodes/{placeID}: private owner record, exact keys
// placeID:string, reportID:20 alphanumeric chars (immutable), code:trimmed printable
// ASCII (1..40), visibility:private/public, createdAt:timestamp (immutable),
// codeUpdatedAt:timestamp, lastVerifiedAt:null/timestamp. Code edits clear checks.
// restroomPasscodeOwners/{reportID}: immutable private ownership reservation,
// ownerUID:string (1..128), placeID:string, createdAt:timestamp. Created with the
// first own record; removed only with the own record and public projection.
// restroomPasscodeReports/{placeID}/reports/{reportID}: public projection, exact
// keys placeID, code, codeUpdatedAt, lastVerifiedAt; no account identity. Public
// selected-place queries are bounded to 10. Only the reserved owner edits code.
// users/{uid}/restroomReadyPasscodeChecks/{reportID}: private verification receipt,
// exact placeID, codeUpdatedAt and verifiedAt:timestamp (server time). A public
// check changes only lastVerifiedAt, atomically with a receipt for that version.
// restroomVisitReports/{placeID}/reports/{20-character reportID}: immutable public
// observedAt:timestamp (2000..request.time), submittedAt:timestamp (server time),
// placeID:string (existing public place; 1..128), entryRule:not-reported/public/customers,
// purchaseRequired/codeRequired/stairs/soap/toiletPaper:not-reported/yes/no,
// floor:not-reported/entrance/below/above, condition:not-reported/usable/needs-attention.
// At least one fact is known; no identity, free text, code value or coordinates.
// users/{uid}/restroomReadyVisitReceipts/{same reportID}: exact placeID/submittedAt.
// Public selected-place reads are bounded to 10; private receipts use owner GET only.
// Both creation and owner deletion require the paired public/private transition.
// restroomPublicNotes/{placeID}/notes/{20-character noteID}: immutable public
// schemaVersion:int(1), placeID:string, observedAt/submittedAt:timestamp,
// body:string(0..1000), condition:enum, soap/toiletPaper/stairs:answer enum.
// A nonblank body or one known structured answer is required. No account
// identity is attached; people must avoid personal information in public text.
// users/{uid}/restroomReadyPublicNoteReceipts/{same noteID}: exact
// placeID/submittedAt ownership pair. Public latest-note reads are bounded to
// ten; receipt GET and bounded LIST (at most 50) are restricted to their owner.
// Creation/deletion require both documents.
// restroomAccessDetails/{placeID}: optional administrator-written public data.
// Exact 15-field SDK contract: schemaVersion:int(1), placeID:safe public ID(1..160),
// restroomHours:null/string(1..160), entranceLocation:null/string(1..500),
// entranceStepFree/stairFreeRoute/elevatorToRestroom:yes/no/unknown,
// elevatorNote:null/string(1..300), restroomFloor:null/string(1..80),
// stairsAfterEntry:null/int(0..200), sourceTitle:string(1..160),
// reportedAt:timestamp, observedOn:null/timestamp, updatedAt:timestamp,
// limitations:string(1..1000). No account identity, private notes or codes.
// Trusted administration provisions the public projection; every client write
// is denied, including clients with an admin claim. SDKs reject malformed data
// and mismatched IDs. Public collection queries must explicitly limit to 1,000.
// restroomResearchProfiles/{placeID}: administrator-written public card facts.
// schemaVersion 1, exact placeID, reviewed manifest SHA256, generatedAt, bounded
// sources/facts/comments and coveredCommentIDs. No private authors or ownership.
// Both clients strictly decode the projection. Exact public GET only; collection
// lists, descendants and every client write (including claimed admins) stay denied.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/accountDeletionLocks/$(request.auth.uid));
    }
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    function validPlaceID(value) {
      return value is string && value.size() > 0 && value.size() <= 128
        && value.matches('^[^/]+$')
        && (!value.matches('^community-.*') || (isCommunityPlaceID(value)
          && exists(/databases/$(database)/documents/communityRestrooms/$(value))));
    }
    function validAnswer(value) {
      return value in ['not-reported', 'yes', 'no'];
    }
    function isValidSaved(data, placeID) {
      return data.keys().hasAll(['placeID', 'savedAt'])
        && data.keys().hasOnly(['placeID', 'savedAt'])
        && validPlaceID(data.placeID) && data.placeID == placeID
        && data.savedAt is timestamp && data.savedAt == request.time;
    }
    function isValidNote(data) {
      return data.keys().hasAll(['placeID', 'observedAt', 'submittedAt',
          'condition', 'soap', 'toiletPaper', 'stairs', 'entryNote'])
        && data.keys().hasOnly(['placeID', 'observedAt', 'submittedAt',
          'condition', 'soap', 'toiletPaper', 'stairs', 'entryNote'])
        && validPlaceID(data.placeID)
        && data.observedAt is timestamp
        && data.observedAt >= timestamp.date(2000, 1, 1)
        && data.observedAt <= request.time
        && data.submittedAt is timestamp && data.submittedAt == request.time
        && data.condition in ['not-reported', 'usable', 'needs-attention']
        && validAnswer(data.soap) && validAnswer(data.toiletPaper)
        && validAnswer(data.stairs)
        && data.entryNote is string && data.entryNote.size() <= 1000;
    }
    function isRatingOwner(uid) {
      return isOwner(uid)
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous';
    }
    // Server-only suspensions never block browsing, private Saved or owned cleanup.
    function canContribute(uid) {
      return isRatingOwner(uid)
        && !exists(/databases/$(database)/documents/restroomContributorSuspensions/$(uid));
    }
    // First-pass whole-token filter; private reporting and human moderation cover context.
    function allowedPublicText(value) {
      return value is string && !value.lower().matches("(?s).*(?:^|[^a-z0-9_])(?:fuck(?:ing|er|ers|ed)?|motherfuck(?:er|ers|ing)?|n[i1]gg(?:er|ers|a|as)|f[a4]gg?[o0]t(?:s)?|k[i1]ll[ \\t]+yourself|go[ \\t]+die|child[ \\t]+porn|rape[ \\t]+you)(?:$|[^a-z0-9_]).*");
    }
    function isVisitPlaceID(placeID) {
      return placeID is string && placeID.size() > 0 && placeID.size() <= 128
        && placeID.matches('^[A-Za-z0-9][A-Za-z0-9:._~-]{0,127}$')
        && exists(/databases/$(database)/documents/restroomRatingSummaries/$(placeID))
        && (!placeID.matches('^community-.*') || (isCommunityPlaceID(placeID)
          && exists(/databases/$(database)/documents/communityRestrooms/$(placeID))));
    }
    function isValidVisitReport(data, placeID) {
      return data.keys().hasAll(['placeID', 'observedAt', 'submittedAt', 'entryRule',
          'purchaseRequired', 'codeRequired', 'stairs', 'soap', 'toiletPaper', 'floor', 'condition'])
        && data.keys().hasOnly(['placeID', 'observedAt', 'submittedAt', 'entryRule',
          'purchaseRequired', 'codeRequired', 'stairs', 'soap', 'toiletPaper', 'floor', 'condition'])
        && isVisitPlaceID(data.placeID) && data.placeID == placeID
        && data.observedAt is timestamp && data.observedAt >= timestamp.date(2000, 1, 1)
        && data.observedAt <= request.time
        && data.submittedAt is timestamp && data.submittedAt == request.time
        && data.entryRule in ['not-reported', 'public', 'customers']
        && data.floor in ['not-reported', 'entrance', 'below', 'above']
        && data.condition in ['not-reported', 'usable', 'needs-attention']
        && validAnswer(data.purchaseRequired) && validAnswer(data.codeRequired)
        && validAnswer(data.stairs) && validAnswer(data.soap) && validAnswer(data.toiletPaper)
        && (data.entryRule != 'not-reported' || data.floor != 'not-reported'
          || data.condition != 'not-reported' || data.purchaseRequired != 'not-reported'
          || data.codeRequired != 'not-reported' || data.stairs != 'not-reported'
          || data.soap != 'not-reported' || data.toiletPaper != 'not-reported');
    }
    function isValidVisitReceipt(data, placeID) {
      return data.keys().hasAll(['placeID', 'submittedAt'])
        && data.keys().hasOnly(['placeID', 'submittedAt'])
        && isVisitPlaceID(data.placeID) && data.placeID == placeID
        && data.submittedAt is timestamp && data.submittedAt == request.time;
    }
    function isNewVisitReport(uid, placeID, reportID) {
      let publicPath = /databases/$(database)/documents/restroomVisitReports/$(placeID)/reports/$(reportID);
      let privatePath = /databases/$(database)/documents/users/$(uid)/restroomReadyVisitReceipts/$(reportID);
      return canContribute(uid) && isPasscodeReportID(reportID)
        && !exists(publicPath) && !exists(privatePath)
        && isValidVisitReport(getAfter(publicPath).data, placeID)
        && isValidVisitReceipt(getAfter(privatePath).data, placeID)
        && getAfter(publicPath).data.submittedAt == getAfter(privatePath).data.submittedAt;
    }
    function isOwnerVisitDeletion(uid, placeID, reportID) {
      let publicPath = /databases/$(database)/documents/restroomVisitReports/$(placeID)/reports/$(reportID);
      let privatePath = /databases/$(database)/documents/users/$(uid)/restroomReadyVisitReceipts/$(reportID);
      return isRatingOwner(uid) && isPasscodeReportID(reportID)
        && exists(publicPath) && exists(privatePath)
        && get(privatePath).data.keys().hasAll(['placeID', 'submittedAt'])
        && get(privatePath).data.keys().hasOnly(['placeID', 'submittedAt'])
        && get(privatePath).data.placeID == placeID
        && get(publicPath).data.placeID == placeID
        && get(privatePath).data.submittedAt is timestamp
        && get(privatePath).data.submittedAt == get(publicPath).data.submittedAt
        && getAfter(publicPath) == null && getAfter(privatePath) == null;
    }
    function isValidPublicNote(data, placeID) {
      return data.keys().hasAll(['schemaVersion', 'placeID', 'observedAt',
          'submittedAt', 'body', 'condition', 'soap', 'toiletPaper', 'stairs'])
        && data.keys().hasOnly(['schemaVersion', 'placeID', 'observedAt',
          'submittedAt', 'body', 'condition', 'soap', 'toiletPaper', 'stairs'])
        && data.schemaVersion is int && data.schemaVersion == 1
        && isVisitPlaceID(data.placeID) && data.placeID == placeID
        && data.observedAt is timestamp && data.observedAt >= timestamp.date(2000, 1, 1)
        && data.observedAt <= request.time
        && data.submittedAt is timestamp && data.submittedAt == request.time
        && data.body is string && data.body.size() <= 1000 && allowedPublicText(data.body)
        && data.body.matches('^[^\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F\\x7F]*$')
        && data.condition in ['not-reported', 'usable', 'needs-attention']
        && validAnswer(data.soap) && validAnswer(data.toiletPaper) && validAnswer(data.stairs)
        && (data.body.matches('(?s).*[^\\s\\p{Z}\\x85].*') || data.condition != 'not-reported'
          || data.soap != 'not-reported' || data.toiletPaper != 'not-reported'
          || data.stairs != 'not-reported');
    }
    function isValidPublicNoteReceipt(data, placeID) {
      return data.keys().hasAll(['placeID', 'submittedAt'])
        && data.keys().hasOnly(['placeID', 'submittedAt'])
        && isVisitPlaceID(data.placeID) && data.placeID == placeID
        && data.submittedAt is timestamp && data.submittedAt == request.time;
    }
    function isNewPublicNote(uid, placeID, noteID) {
      let publicPath = /databases/$(database)/documents/restroomPublicNotes/$(placeID)/notes/$(noteID);
      let privatePath = /databases/$(database)/documents/users/$(uid)/restroomReadyPublicNoteReceipts/$(noteID);
      return canContribute(uid) && isPasscodeReportID(noteID)
        && !exists(/databases/$(database)/documents/restroomModerationRemovals/$(placeID)/publicNotes/$(noteID))
        && !exists(publicPath) && !exists(privatePath)
        && isValidPublicNote(getAfter(publicPath).data, placeID)
        && isValidPublicNoteReceipt(getAfter(privatePath).data, placeID)
        && getAfter(publicPath).data.submittedAt == getAfter(privatePath).data.submittedAt;
    }
    function isOwnerPublicNoteDeletion(uid, placeID, noteID) {
      let publicPath = /databases/$(database)/documents/restroomPublicNotes/$(placeID)/notes/$(noteID);
      let privatePath = /databases/$(database)/documents/users/$(uid)/restroomReadyPublicNoteReceipts/$(noteID);
      return isRatingOwner(uid) && isPasscodeReportID(noteID)
        && exists(publicPath) && exists(privatePath)
        && get(privatePath).data.keys().hasAll(['placeID', 'submittedAt'])
        && get(privatePath).data.keys().hasOnly(['placeID', 'submittedAt'])
        && get(privatePath).data.placeID == placeID
        && get(publicPath).data.placeID == placeID
        && get(privatePath).data.submittedAt is timestamp
        && get(privatePath).data.submittedAt == get(publicPath).data.submittedAt
        && getAfter(publicPath) == null && getAfter(privatePath) == null;
    }
    function isValidRatingSummary(data) {
      return data.keys().hasAll(['ratingCount', 'ratingSum', 'updatedAt'])
        && data.keys().hasOnly(['ratingCount', 'ratingSum', 'updatedAt'])
        && data.ratingCount is int && data.ratingCount >= 0 && data.ratingCount <= 1000000
        && data.ratingSum is number && data.ratingSum >= data.ratingCount
        && data.ratingSum <= data.ratingCount * 5
        && data.ratingSum * 2 == math.floor(data.ratingSum * 2)
        && data.updatedAt is timestamp;
    }
    function isValidRatingVote(data) {
      return data.keys().hasAll(['stars', 'updatedAt'])
        && data.keys().hasOnly(['stars', 'updatedAt'])
        && data.stars is number && data.stars in [1, 1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5]
        && data.updatedAt is timestamp;
    }
    function isValidRatingTransition(placeID, uid) {
      let summaryPath = /databases/$(database)/documents/restroomRatingSummaries/$(placeID);
      let votePath = /databases/$(database)/documents/restroomRatingSummaries/$(placeID)/ratings/$(uid);
      let beforeSummary = get(summaryPath).data;
      let afterSummary = getAfter(summaryPath).data;
      let beforeVote = get(votePath);
      let afterVote = getAfter(votePath);
      let oldStars = beforeVote == null ? 0 : beforeVote.data.stars;
      let newStars = afterVote == null ? 0 : afterVote.data.stars;
      return validPlaceID(placeID)
        && isValidRatingSummary(beforeSummary) && isValidRatingSummary(afterSummary)
        && afterSummary.updatedAt == request.time
        && afterSummary.updatedAt != beforeSummary.updatedAt
        && (beforeVote == null || isValidRatingVote(beforeVote.data))
        && (afterVote == null || (isValidRatingVote(afterVote.data) && afterVote.data.updatedAt == request.time))
        && (beforeVote != null || afterVote != null)
        && oldStars != newStars
        && afterSummary.ratingCount == beforeSummary.ratingCount
          + (afterVote == null ? 0 : 1) - (beforeVote == null ? 0 : 1)
        && afterSummary.ratingSum == beforeSummary.ratingSum + newStars - oldStars;
    }
    function isCommunityPlaceID(value) {
      return value is string && value.size() == 30 && value.matches('^community-[a-zA-Z0-9]{20}$');
    }
    function isValidCommunityText(value) {
      return value is string && value.matches('^[^\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F\\x7F]*$');
    }
    function isValidCommunityRestroom(data) {
      return data.keys().hasAll(['name', 'address', 'latitude', 'longitude', 'locationType',
          'entryRule', 'stepFreeAccess', 'notes', 'observedOn', 'submittedAt'])
        && data.keys().hasOnly(['name', 'address', 'latitude', 'longitude', 'locationType',
          'entryRule', 'stepFreeAccess', 'notes', 'observedOn', 'submittedAt', 'passcodeRequired'])
        && isValidCommunityText(data.name) && data.name.size() > 0 && data.name.size() <= 120
        && data.name.matches('.*[^\\s\\x{00A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}].*')
        && isValidCommunityText(data.address) && data.address.size() > 0 && data.address.size() <= 240
        && data.address.matches('.*[^\\s\\x{00A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}].*')
        && data.latitude is number && data.latitude >= 40.49 && data.latitude <= 40.93
        && data.longitude is number && data.longitude >= -74.26 && data.longitude <= -73.68
        && data.locationType in ['park', 'library', 'cafe', 'restaurant', 'store', 'other']
        && data.entryRule in ['public', 'customers', 'unknown']
        && data.stepFreeAccess in ['yes', 'no', 'unknown']
        && (!('passcodeRequired' in data) || data.passcodeRequired in ['yes', 'no', 'unknown'])
        && isValidCommunityText(data.notes) && data.notes.size() <= 1000
        && (data.observedOn == null || (data.observedOn is timestamp
          && data.observedOn >= timestamp.date(2000, 1, 1) && data.observedOn <= request.time
          && data.observedOn.hours() == 0 && data.observedOn.minutes() == 0
          && data.observedOn.seconds() == 0 && data.observedOn.nanos() == 0))
        && data.submittedAt is timestamp && data.submittedAt == request.time;
    }
    function isValidSubmissionReceipt(data) {
      return data.keys().hasAll(['ownerUID', 'submittedAt'])
        && data.keys().hasOnly(['ownerUID', 'submittedAt'])
        && data.ownerUID is string && data.ownerUID.size() > 0 && data.ownerUID.size() <= 128
        && data.ownerUID == request.auth.uid
        && data.submittedAt is timestamp && data.submittedAt == request.time;
    }
    function isValidPendingCommunityRequest(data) {
      return data.keys().hasAll(['schemaVersion', 'status', 'revision', 'submittedAt', 'listing', 'codeDraft'])
        && data.keys().hasOnly(['schemaVersion', 'status', 'revision', 'submittedAt', 'listing', 'codeDraft'])
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.status == 'pending' && data.revision is int && data.revision == 1
        && data.submittedAt is timestamp && data.submittedAt == request.time
        && data.listing is map && isValidCommunityRestroom(data.listing)
        && data.listing.keys().hasAll(['passcodeRequired'])
        && data.listing.submittedAt == data.submittedAt
        && (data.codeDraft == null || (data.codeDraft is map
          && data.codeDraft.keys().hasAll(['code', 'visibility'])
          && data.codeDraft.keys().hasOnly(['code', 'visibility'])
          && data.listing.get('passcodeRequired', 'unknown') == 'yes'
          && isValidPasscodeText(data.codeDraft.code)
          && data.codeDraft.visibility in ['private', 'public']));
    }
    function isNewPendingCommunityRequest(uid, placeID) {
      let requestPath = /databases/$(database)/documents/users/$(uid)/restroomReadySubmissionRequests/$(placeID);
      let listingPath = /databases/$(database)/documents/communityRestrooms/$(placeID);
      let receiptPath = /databases/$(database)/documents/restroomSubmissions/$(placeID);
      let summaryPath = /databases/$(database)/documents/restroomRatingSummaries/$(placeID);
      let pending = getAfter(requestPath).data;
      let receipt = getAfter(receiptPath).data;
      return canContribute(uid) && isCommunityPlaceID(placeID)
        && !exists(requestPath) && !exists(receiptPath)
        && !exists(listingPath) && !exists(summaryPath)
        && isValidPendingCommunityRequest(pending) && isValidSubmissionReceipt(receipt)
        && pending.submittedAt == receipt.submittedAt;
    }
    function isPasscodeReportID(value) {
      return value is string && value.size() == 20 && value.matches('^[a-zA-Z0-9]{20}$');
    }
    function isPasscodePlaceID(value) {
      return value is string && value.size() > 0 && value.size() <= 128
        && value.matches('^[^/]+$')
        && existsAfter(/databases/$(database)/documents/restroomRatingSummaries/$(value))
        && (!value.matches('^community-.*') || (isCommunityPlaceID(value)
          && existsAfter(/databases/$(database)/documents/communityRestrooms/$(value))));
    }
    function isValidPasscodeText(value) {
      return value is string && value.size() > 0 && value.size() <= 40
        && value.matches('^[!-~]([ -~]*[!-~])?$');
    }
    function allowedPublicCodeVersion(placeID, reportID, version, kind) {
      let marker = kind == 'legacy-code'
        ? get(/databases/$(database)/documents/restroomModerationRemovals/$(placeID)/legacyCodes/$(reportID))
        : get(/databases/$(database)/documents/restroomModerationRemovals/$(placeID)/v2Codes/$(reportID));
      return marker == null || (kind == 'legacy-code' && marker.data.kind == kind && marker.data.placeID == placeID
        && marker.data.recordID == reportID && marker.data.codeUpdatedAt is timestamp
        && version is timestamp && version > marker.data.codeUpdatedAt);
    }
    function isValidPasscodeTimes(data) {
      return data.codeUpdatedAt is timestamp
        && data.codeUpdatedAt >= timestamp.date(2000, 1, 1)
        && data.codeUpdatedAt <= request.time
        && (data.lastVerifiedAt == null || (data.lastVerifiedAt is timestamp
          && data.lastVerifiedAt >= data.codeUpdatedAt && data.lastVerifiedAt <= request.time));
    }
    function isValidOwnPasscode(data, placeID) {
      return data.keys().hasAll(['placeID', 'reportID', 'code', 'visibility',
          'createdAt', 'codeUpdatedAt', 'lastVerifiedAt'])
        && data.keys().hasOnly(['placeID', 'reportID', 'code', 'visibility',
          'createdAt', 'codeUpdatedAt', 'lastVerifiedAt'])
        && data.placeID == placeID && isPasscodePlaceID(data.placeID)
        && isPasscodeReportID(data.reportID) && isValidPasscodeText(data.code)
        && data.visibility in ['private', 'public']
        && data.createdAt is timestamp && data.createdAt >= timestamp.date(2000, 1, 1)
        && data.createdAt <= data.codeUpdatedAt && isValidPasscodeTimes(data);
    }
    function isValidPasscodeOwner(data, reportID) {
      return isPasscodeReportID(reportID)
        && data.keys().hasAll(['ownerUID', 'placeID', 'createdAt'])
        && data.keys().hasOnly(['ownerUID', 'placeID', 'createdAt'])
        && data.ownerUID is string && data.ownerUID.size() > 0 && data.ownerUID.size() <= 128
        && data.ownerUID == request.auth.uid && isPasscodePlaceID(data.placeID)
        && data.createdAt is timestamp && data.createdAt >= timestamp.date(2000, 1, 1)
        && data.createdAt <= request.time;
    }
    function isValidPublicPasscode(data, placeID) {
      return data.keys().hasAll(['placeID', 'code', 'codeUpdatedAt', 'lastVerifiedAt'])
        && data.keys().hasOnly(['placeID', 'code', 'codeUpdatedAt', 'lastVerifiedAt'])
        && data.placeID == placeID && isPasscodePlaceID(data.placeID)
