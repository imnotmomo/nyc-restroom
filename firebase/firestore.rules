// Restroom Ready account data. Prototype rules; see docs/firebase-setup.md.
// users/{uid}/restroomReadySaved/{placeID}: placeID:string (1..128, immutable
// and equal to document ID), savedAt:timestamp (server write time).
// users/{uid}/restroomReadyNotes/{noteID}: placeID:string (1..128),
// observedAt:timestamp (2000..request.time), submittedAt:timestamp (server time),
// condition:enum, soap/toiletPaper/stairs:enum, entryNote:string (0..1000).
// Notes are immutable after creation; their owner may delete them.
// No users/{uid} profile document is required or created. The UID in the path
// scopes these private subcollections; no identity/role/email field is accepted.
// restroomRatingSummaries/{placeID}: ratingCount:int (0..1,000,000),
// ratingSum:number (multiples of 0.5 in count..5*count, zero for zero count),
// updatedAt:timestamp. Existing integer totals remain valid.
// A trusted initializer creates source-listing summaries. Clients may initialize
// a zero summary only alongside a new immutable community listing and receipt.
// All subsequent changes require a paired private vote; no client deletion.
// restroomRatingSummaries/{placeID}/ratings/{uid}: stars:number (1..5 by 0.5),
// updatedAt:timestamp. Only that signed-in non-anonymous account may GET/write
// its vote. Public reads expose aggregate counts/sums, never raw vote owners.
// communityRestrooms/{community-<20 alphanumeric chars>}: immutable public report.
// name:string (1..120), address:string (1..240), latitude:number (40.49..40.93),
// longitude:number (-74.26..-73.68), locationType:park/library/cafe/restaurant/store/other,
// entryRule:public/customers/unknown, stepFreeAccess:yes/no/unknown,
// notes:string (0..1000), observedOn:null or UTC-midnight timestamp (2000..now),
// submittedAt:timestamp (server time). Bounding rectangle approximates NYC extent;
// a visitor report is neither city-verified access nor a cleanliness guarantee.
// restroomSubmissions/{sameID}: private ownerUID:string (1..128, authenticated UID),
// submittedAt:timestamp (same server time). No public name/email/UID fields accepted.
// The three creation documents are atomic. Public GET and bounded latest-feed LIST
// expose venue reports; only the owner can GET their receipt. No receipt LIST.
// communityRestrooms may additionally contain passcodeRequired:yes/no/unknown.
// Codes never belong in that public listing document.
// users/{uid}/restroomReadyPasscodes/{placeID}: private owner record, exact keys
// placeID:string, reportID:20 alphanumeric chars (immutable), code:trimmed printable
// ASCII (1..40), visibility:private/public, createdAt:timestamp (immutable),
// codeUpdatedAt:timestamp, lastVerifiedAt:null/timestamp. Code edits clear checks.
// restroomPasscodeOwners/{reportID}: immutable private ownership reservation,
// ownerUID:string (1..128), placeID:string, createdAt:timestamp. Created with the
// first own record; removed only with the own record and public projection.
// restroomPasscodeReports/{placeID}/reports/{reportID}: public projection, exact
// keys placeID, code, codeUpdatedAt, lastVerifiedAt; no account identity. Public
// selected-place queries are bounded to 10. Only the reserved owner edits code.
// users/{uid}/restroomReadyPasscodeChecks/{reportID}: private verification receipt,
// exact placeID, codeUpdatedAt and verifiedAt:timestamp (server time). A public
// check changes only lastVerifiedAt, atomically with a receipt for that version.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    function validPlaceID(value) {
      return value is string && value.size() > 0 && value.size() <= 128
        && value.matches('^[^/]+$')
        && (!value.matches('^community-.*') || (isCommunityPlaceID(value)
          && exists(/databases/$(database)/documents/communityRestrooms/$(value))));
    }
    function validAnswer(value) {
      return value in ['not-reported', 'yes', 'no'];
    }
    function isValidSaved(data, placeID) {
      return data.keys().hasAll(['placeID', 'savedAt'])
        && data.keys().hasOnly(['placeID', 'savedAt'])
        && (validPlaceID(data.placeID) || (isCommunityPlaceID(data.placeID)
          && isNewCommunitySubmission(data.placeID))) && data.placeID == placeID
        && data.savedAt is timestamp && data.savedAt == request.time;
    }
    function isValidNote(data) {
      return data.keys().hasAll(['placeID', 'observedAt', 'submittedAt',
          'condition', 'soap', 'toiletPaper', 'stairs', 'entryNote'])
        && data.keys().hasOnly(['placeID', 'observedAt', 'submittedAt',
          'condition', 'soap', 'toiletPaper', 'stairs', 'entryNote'])
        && validPlaceID(data.placeID)
        && data.observedAt is timestamp
        && data.observedAt >= timestamp.date(2000, 1, 1)
        && data.observedAt <= request.time
        && data.submittedAt is timestamp && data.submittedAt == request.time
        && data.condition in ['not-reported', 'usable', 'needs-attention']
        && validAnswer(data.soap) && validAnswer(data.toiletPaper)
        && validAnswer(data.stairs)
        && data.entryNote is string && data.entryNote.size() <= 1000;
    }
    function isRatingOwner(uid) {
      return isOwner(uid)
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous';
    }
    function isValidRatingSummary(data) {
      return data.keys().hasAll(['ratingCount', 'ratingSum', 'updatedAt'])
        && data.keys().hasOnly(['ratingCount', 'ratingSum', 'updatedAt'])
        && data.ratingCount is int && data.ratingCount >= 0 && data.ratingCount <= 1000000
        && data.ratingSum is number && data.ratingSum >= data.ratingCount
        && data.ratingSum <= data.ratingCount * 5
        && data.ratingSum * 2 == math.floor(data.ratingSum * 2)
        && data.updatedAt is timestamp;
    }
    function isValidRatingVote(data) {
      return data.keys().hasAll(['stars', 'updatedAt'])
        && data.keys().hasOnly(['stars', 'updatedAt'])
        && data.stars is number && data.stars in [1, 1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5]
        && data.updatedAt is timestamp;
    }
    function isValidRatingTransition(placeID, uid) {
      let summaryPath = /databases/$(database)/documents/restroomRatingSummaries/$(placeID);
      let votePath = /databases/$(database)/documents/restroomRatingSummaries/$(placeID)/ratings/$(uid);
      let beforeSummary = get(summaryPath).data;
      let afterSummary = getAfter(summaryPath).data;
      let beforeVote = get(votePath);
      let afterVote = getAfter(votePath);
      let oldStars = beforeVote == null ? 0 : beforeVote.data.stars;
      let newStars = afterVote == null ? 0 : afterVote.data.stars;
      return validPlaceID(placeID)
        && isValidRatingSummary(beforeSummary) && isValidRatingSummary(afterSummary)
        && afterSummary.updatedAt == request.time
        && afterSummary.updatedAt != beforeSummary.updatedAt
        && (beforeVote == null || isValidRatingVote(beforeVote.data))
        && (afterVote == null || (isValidRatingVote(afterVote.data) && afterVote.data.updatedAt == request.time))
        && (beforeVote != null || afterVote != null)
        && oldStars != newStars
        && afterSummary.ratingCount == beforeSummary.ratingCount
          + (afterVote == null ? 0 : 1) - (beforeVote == null ? 0 : 1)
        && afterSummary.ratingSum == beforeSummary.ratingSum + newStars - oldStars;
    }
    function isCommunityPlaceID(value) {
      return value is string && value.size() == 30 && value.matches('^community-[a-zA-Z0-9]{20}$');
    }
    function isValidCommunityText(value) {
      return value is string && value.matches('^[^\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F\\x7F]*$');
    }
    function isValidCommunityRestroom(data) {
      return data.keys().hasAll(['name', 'address', 'latitude', 'longitude', 'locationType',
          'entryRule', 'stepFreeAccess', 'notes', 'observedOn', 'submittedAt'])
        && data.keys().hasOnly(['name', 'address', 'latitude', 'longitude', 'locationType',
          'entryRule', 'stepFreeAccess', 'notes', 'observedOn', 'submittedAt', 'passcodeRequired'])
        && isValidCommunityText(data.name) && data.name.size() > 0 && data.name.size() <= 120
        && data.name.matches('.*[^\\s\\x{00A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}].*')
        && isValidCommunityText(data.address) && data.address.size() > 0 && data.address.size() <= 240
        && data.address.matches('.*[^\\s\\x{00A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}].*')
        && data.latitude is number && data.latitude >= 40.49 && data.latitude <= 40.93
        && data.longitude is number && data.longitude >= -74.26 && data.longitude <= -73.68
        && data.locationType in ['park', 'library', 'cafe', 'restaurant', 'store', 'other']
        && data.entryRule in ['public', 'customers', 'unknown']
        && data.stepFreeAccess in ['yes', 'no', 'unknown']
        && (!('passcodeRequired' in data) || data.passcodeRequired in ['yes', 'no', 'unknown'])
        && isValidCommunityText(data.notes) && data.notes.size() <= 1000
        && (data.observedOn == null || (data.observedOn is timestamp
          && data.observedOn >= timestamp.date(2000, 1, 1) && data.observedOn <= request.time
          && data.observedOn.hours() == 0 && data.observedOn.minutes() == 0
          && data.observedOn.seconds() == 0 && data.observedOn.nanos() == 0))
        && data.submittedAt is timestamp && data.submittedAt == request.time;
    }
    function isValidSubmissionReceipt(data) {
      return data.keys().hasAll(['ownerUID', 'submittedAt'])
        && data.keys().hasOnly(['ownerUID', 'submittedAt'])
        && data.ownerUID is string && data.ownerUID.size() > 0 && data.ownerUID.size() <= 128
        && data.ownerUID == request.auth.uid
        && data.submittedAt is timestamp && data.submittedAt == request.time;
    }
    function isNewCommunitySubmission(placeID) {
      let listingPath = /databases/$(database)/documents/communityRestrooms/$(placeID);
      let receiptPath = /databases/$(database)/documents/restroomSubmissions/$(placeID);
      let summaryPath = /databases/$(database)/documents/restroomRatingSummaries/$(placeID);
      let listing = getAfter(listingPath).data;
      let receipt = getAfter(receiptPath).data;
      let summary = getAfter(summaryPath).data;
      return isRatingOwner(request.auth.uid) && isCommunityPlaceID(placeID)
        && !exists(listingPath) && !exists(receiptPath) && !exists(summaryPath)
        && isValidCommunityRestroom(listing) && isValidSubmissionReceipt(receipt)
        && isValidRatingSummary(summary) && summary.ratingCount == 0 && summary.ratingSum == 0
        && summary.updatedAt == request.time;
    }
    function isPasscodeReportID(value) {
      return value is string && value.size() == 20 && value.matches('^[a-zA-Z0-9]{20}$');
    }
    function isPasscodePlaceID(value) {
      return value is string && value.size() > 0 && value.size() <= 128
        && value.matches('^[^/]+$')
        && existsAfter(/databases/$(database)/documents/restroomRatingSummaries/$(value))
        && (!value.matches('^community-.*') || (isCommunityPlaceID(value)
          && existsAfter(/databases/$(database)/documents/communityRestrooms/$(value))));
    }
    function isValidPasscodeText(value) {
      return value is string && value.size() > 0 && value.size() <= 40
        && value.matches('^[!-~]([ -~]*[!-~])?$');
    }
    function isValidPasscodeTimes(data) {
      return data.codeUpdatedAt is timestamp
        && data.codeUpdatedAt >= timestamp.date(2000, 1, 1)
        && data.codeUpdatedAt <= request.time
        && (data.lastVerifiedAt == null || (data.lastVerifiedAt is timestamp
          && data.lastVerifiedAt >= data.codeUpdatedAt && data.lastVerifiedAt <= request.time));
    }
    function isValidOwnPasscode(data, placeID) {
      return data.keys().hasAll(['placeID', 'reportID', 'code', 'visibility',
          'createdAt', 'codeUpdatedAt', 'lastVerifiedAt'])
        && data.keys().hasOnly(['placeID', 'reportID', 'code', 'visibility',
          'createdAt', 'codeUpdatedAt', 'lastVerifiedAt'])
        && data.placeID == placeID && isPasscodePlaceID(data.placeID)
        && isPasscodeReportID(data.reportID) && isValidPasscodeText(data.code)
        && data.visibility in ['private', 'public']
        && data.createdAt is timestamp && data.createdAt >= timestamp.date(2000, 1, 1)
        && data.createdAt <= data.codeUpdatedAt && isValidPasscodeTimes(data);
    }
    function isValidPasscodeOwner(data, reportID) {
      return isPasscodeReportID(reportID)
        && data.keys().hasAll(['ownerUID', 'placeID', 'createdAt'])
        && data.keys().hasOnly(['ownerUID', 'placeID', 'createdAt'])
        && data.ownerUID is string && data.ownerUID.size() > 0 && data.ownerUID.size() <= 128
        && data.ownerUID == request.auth.uid && isPasscodePlaceID(data.placeID)
        && data.createdAt is timestamp && data.createdAt >= timestamp.date(2000, 1, 1)
        && data.createdAt <= request.time;
    }
    function isValidPublicPasscode(data, placeID) {
      return data.keys().hasAll(['placeID', 'code', 'codeUpdatedAt', 'lastVerifiedAt'])
        && data.keys().hasOnly(['placeID', 'code', 'codeUpdatedAt', 'lastVerifiedAt'])
        && data.placeID == placeID && isPasscodePlaceID(data.placeID)
        && isValidPasscodeText(data.code) && isValidPasscodeTimes(data);
    }
    function isValidPasscodeCheck(data) {
      return data.keys().hasAll(['placeID', 'codeUpdatedAt', 'verifiedAt'])
        && data.keys().hasOnly(['placeID', 'codeUpdatedAt', 'verifiedAt'])
        && isPasscodePlaceID(data.placeID) && data.codeUpdatedAt is timestamp
        && data.codeUpdatedAt >= timestamp.date(2000, 1, 1)
        && data.verifiedAt is timestamp && data.verifiedAt == request.time
        && data.codeUpdatedAt <= data.verifiedAt;
    }
    function passcodeIsSaved(uid, placeID) {
      let saved = getAfter(/databases/$(database)/documents/users/$(uid)/restroomReadySaved/$(placeID));
      return saved != null && saved.data.keys().hasAll(['placeID', 'savedAt'])
        && saved.data.keys().hasOnly(['placeID', 'savedAt'])
        && saved.data.placeID == placeID && saved.data.savedAt is timestamp
        && saved.data.savedAt <= request.time;
    }
    function passcodeReservationMatches(uid, placeID, own) {
      let reservation = getAfter(/databases/$(database)/documents/restroomPasscodeOwners/$(own.reportID));
      return reservation != null && isValidPasscodeOwner(reservation.data, own.reportID)
        && reservation.data.ownerUID == uid && reservation.data.placeID == placeID
        && reservation.data.createdAt == own.createdAt;
    }
    function passcodeProjectionMatches(placeID, own, oldOwn) {
      let path = /databases/$(database)/documents/restroomPasscodeReports/$(placeID)/reports/$(own.reportID);
      let before = get(path);
      let after = getAfter(path);
      let samePublicCode = oldOwn.get('visibility', '') == 'public'
        && oldOwn.get('code', '') == own.code;
      let expectedCheck = samePublicCode && before != null ? before.data.lastVerifiedAt : own.lastVerifiedAt;
      return own.visibility == 'private' ? after == null
        : after != null && isValidPublicPasscode(after.data, placeID)
          && after.data.code == own.code && after.data.codeUpdatedAt == own.codeUpdatedAt
          && after.data.lastVerifiedAt == expectedCheck;
    }
    function isValidOwnPasscodeCreate(uid, placeID, data) {
      return data.createdAt == request.time && data.codeUpdatedAt == request.time
        && data.lastVerifiedAt == null
        && !exists(/databases/$(database)/documents/restroomPasscodeOwners/$(data.reportID))
        && passcodeReservationMatches(uid, placeID, data)
        && (data.visibility != 'private' || passcodeIsSaved(uid, placeID))
        && passcodeProjectionMatches(placeID, data, {});
    }
    function isValidOwnPasscodeUpdate(uid, placeID, data, before) {
      let publicBefore = get(/databases/$(database)/documents/restroomPasscodeReports/$(placeID)/reports/$(before.reportID));
      let sameCode = data.code == before.code;
      let carriesPublicCheck = before.visibility == 'public' && publicBefore != null
        && publicBefore.data.code == before.code && publicBefore.data.codeUpdatedAt == before.codeUpdatedAt
        && data.lastVerifiedAt == publicBefore.data.lastVerifiedAt;
      let explicitCheck = data.lastVerifiedAt == request.time
        && data.lastVerifiedAt != before.lastVerifiedAt
        && data.diff(before).affectedKeys().hasOnly(['lastVerifiedAt']);
      return data.reportID == before.reportID && data.createdAt == before.createdAt
        && passcodeReservationMatches(uid, placeID, data)
        && (sameCode ? data.codeUpdatedAt == before.codeUpdatedAt
            && (before.visibility == 'public' && data.visibility == 'private'
              ? carriesPublicCheck
              : data.lastVerifiedAt == before.lastVerifiedAt || carriesPublicCheck || explicitCheck)
          : data.codeUpdatedAt == request.time && data.codeUpdatedAt != before.codeUpdatedAt
            && data.lastVerifiedAt == null)
        && (data.visibility != 'private' || passcodeIsSaved(uid, placeID))
        && passcodeProjectionMatches(placeID, data, before);
    }
    function isReservedPasscodeOwner(placeID, reportID) {
      let reservation = get(/databases/$(database)/documents/restroomPasscodeOwners/$(reportID));
      return reservation != null && reservation.data.ownerUID == request.auth.uid
        && reservation.data.placeID == placeID;
    }
    function isOwnerPublicPasscodeWrite(placeID, reportID) {
      let reservation = getAfter(/databases/$(database)/documents/restroomPasscodeOwners/$(reportID));
      let ownPath = /databases/$(database)/documents/users/$(request.auth.uid)/restroomReadyPasscodes/$(placeID);
      let beforeOwn = get(ownPath);
      let afterOwn = getAfter(ownPath);
      return reservation != null && isValidPasscodeOwner(reservation.data, reportID)
        && reservation.data.placeID == placeID
        && afterOwn != null && isValidOwnPasscode(afterOwn.data, placeID)
        && afterOwn.data.reportID == reportID && afterOwn.data.visibility == 'public'
        && passcodeProjectionMatches(placeID, afterOwn.data, beforeOwn == null ? {} : beforeOwn.data);
    }
    function isPublicPasscodeVerification(uid, placeID, reportID) {
      let publicPath = /databases/$(database)/documents/restroomPasscodeReports/$(placeID)/reports/$(reportID);
      let before = get(publicPath);
      let after = getAfter(publicPath);
      let checkPath = /databases/$(database)/documents/users/$(uid)/restroomReadyPasscodeChecks/$(reportID);
      let beforeCheck = get(checkPath);
      let afterCheck = getAfter(checkPath);
      return isPasscodeReportID(reportID) && before != null && after != null
        && after.data.diff(before.data).affectedKeys().hasOnly(['lastVerifiedAt'])
        && after.data.lastVerifiedAt == request.time && after.data.lastVerifiedAt != before.data.lastVerifiedAt
        && isValidPublicPasscode(before.data, placeID)
        && afterCheck != null && isValidPasscodeCheck(afterCheck.data)
        && afterCheck.data.placeID == placeID && afterCheck.data.codeUpdatedAt == before.data.codeUpdatedAt
        && (beforeCheck == null || beforeCheck.data.verifiedAt != afterCheck.data.verifiedAt);
    }
    match /users/{uid}/restroomReadyPasscodes/{placeID} {
      allow read: if isRatingOwner(uid);
      allow create: if isRatingOwner(uid) && isValidOwnPasscode(request.resource.data, placeID)
        && isValidOwnPasscodeCreate(uid, placeID, request.resource.data);
      allow update: if isRatingOwner(uid) && isValidOwnPasscode(request.resource.data, placeID)
        && isValidOwnPasscodeUpdate(uid, placeID, request.resource.data, resource.data);
      allow delete: if isRatingOwner(uid)
        && isReservedPasscodeOwner(placeID, resource.data.reportID)
        && getAfter(/databases/$(database)/documents/restroomPasscodeOwners/$(resource.data.reportID)) == null
        && getAfter(/databases/$(database)/documents/restroomPasscodeReports/$(placeID)/reports/$(resource.data.reportID)) == null;
    }
    match /restroomPasscodeOwners/{reportID} {
      allow get: if isRatingOwner(request.auth.uid) && isPasscodeReportID(reportID)
        && (resource == null || resource.data.ownerUID == request.auth.uid);
      allow list, update: if false;
      allow create: if isRatingOwner(request.auth.uid) && isValidPasscodeOwner(request.resource.data, reportID)
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/restroomReadyPasscodes/$(request.resource.data.placeID))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/restroomReadyPasscodes/$(request.resource.data.placeID)).data.reportID == reportID
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/restroomReadyPasscodes/$(request.resource.data.placeID)).data.createdAt == request.time;
      allow delete: if isRatingOwner(request.auth.uid) && resource.data.ownerUID == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/restroomReadyPasscodes/$(resource.data.placeID)).data.reportID == reportID
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/restroomReadyPasscodes/$(resource.data.placeID)) == null
        && getAfter(/databases/$(database)/documents/restroomPasscodeReports/$(resource.data.placeID)/reports/$(reportID)) == null;
    }
    match /restroomPasscodeReports/{placeID}/reports/{reportID} {
      allow get: if validPlaceID(placeID) && isPasscodeReportID(reportID);
      allow list: if validPlaceID(placeID) && request.query.limit != null
        && request.query.limit > 0 && request.query.limit <= 10;
      allow create: if isRatingOwner(request.auth.uid) && isPasscodeReportID(reportID)
        && isValidPublicPasscode(request.resource.data, placeID)
        && isOwnerPublicPasscodeWrite(placeID, reportID);
      allow update: if isRatingOwner(request.auth.uid) && isPasscodeReportID(reportID)
        && isValidPublicPasscode(request.resource.data, placeID)
        && (isPublicPasscodeVerification(request.auth.uid, placeID, reportID)
          || isOwnerPublicPasscodeWrite(placeID, reportID));
      allow delete: if isRatingOwner(request.auth.uid) && isPasscodeReportID(reportID)
        && isReservedPasscodeOwner(placeID, reportID)
        && (getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/restroomReadyPasscodes/$(placeID)) == null
          || getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/restroomReadyPasscodes/$(placeID)).data.visibility == 'private');
    }
    match /users/{uid}/restroomReadyPasscodeChecks/{reportID} {
      allow get: if isRatingOwner(uid) && isPasscodeReportID(reportID);
      allow list, delete: if false;
      allow create, update: if isRatingOwner(uid) && isValidPasscodeCheck(request.resource.data)
        && isPublicPasscodeVerification(uid, request.resource.data.placeID, reportID);
    }
    match /communityRestrooms/{placeID} {
      allow get: if isCommunityPlaceID(placeID);
      allow list: if request.query.limit != null && request.query.limit > 0 && request.query.limit <= 1000;
      allow create: if isNewCommunitySubmission(placeID);
      allow update, delete: if false;
    }
    match /restroomSubmissions/{placeID} {
      allow get: if isRatingOwner(request.auth.uid) && isCommunityPlaceID(placeID)
        && (resource == null || resource.data.ownerUID == request.auth.uid);
      allow list: if false;
      allow create: if isNewCommunitySubmission(placeID);
      allow update, delete: if false;
    }
    match /users/{uid}/restroomReadySaved/{placeID} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && isValidSaved(request.resource.data, placeID);
      allow update: if isOwner(uid) && isValidSaved(request.resource.data, placeID)
        && request.resource.data.placeID == resource.data.placeID;
    }
    match /users/{uid}/restroomReadyNotes/{noteID} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && noteID.size() == 20
        && noteID.matches('^[a-zA-Z0-9]{20}$') && isValidNote(request.resource.data);
      allow update: if false;
    }
    match /restroomRatingSummaries/{placeID} {
      allow get: if validPlaceID(placeID);
      allow list: if resource.data.ratingCount > 0;
      allow create: if isNewCommunitySubmission(placeID);
      allow delete: if false;
      allow update: if isRatingOwner(request.auth.uid)
        && isValidRatingSummary(request.resource.data)
        && isValidRatingTransition(placeID, request.auth.uid);
      match /ratings/{uid} {
        allow get: if isRatingOwner(uid);
        allow list: if false;
        allow create, update: if isRatingOwner(uid)
          && isValidRatingVote(request.resource.data)
          && request.resource.data.updatedAt == request.time
          && isValidRatingTransition(placeID, uid);
        allow delete: if isRatingOwner(uid) && isValidRatingTransition(placeID, uid);
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
