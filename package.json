{
  "name": "restroom-ready",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build && node scripts/build-worker.mjs",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:firebase": "node --test tests/firebase/*.test.mjs"
  },
  "dependencies": {
    "@apple/mapkit-loader": "^1.0.0",
    "firebase": "^13.0.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/apple-mapkit": "^6.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
